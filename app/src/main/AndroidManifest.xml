<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_eco_logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_eco_logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.EcoQuiz">

        <!-- Screen 1: Splash Screen (LAUNCHER) -->
        <activity
            android:name=".activity.SplashActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Screen 2: User Registration -->
        <activity
            android:name=".activity.RegisterActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <!-- Screen 3: User Login -->
        <activity
            android:name=".activity.LoginActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <!-- Screen 4: Home Dashboard -->
        <activity
            android:name=".activity.HomeActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Screen 5: Quiz Interface (Locked portrait to protect countdown timer) -->
        <activity
            android:name=".activity.QuizActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Screen 6: Quiz Result Screen -->
        <activity
            android:name=".activity.ResultActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Screen 7: Performance Analysis -->
        <activity
            android:name=".activity.PerformanceActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Screen 8: Local Leaderboard -->
        <activity
            android:name=".activity.LeaderboardActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Screen 9: User Profile -->
        <activity
            android:name=".activity.ProfileActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

    </application>

</manifest>
