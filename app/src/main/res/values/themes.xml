<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.EcoQuiz" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/primary_forest_green</item>
        <item name="colorPrimaryVariant">@color/primary_dark_green</item>
        <item name="colorOnPrimary">@color/surface_white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/secondary_light_green</item>
        <item name="colorSecondaryVariant">@color/primary_light_green</item>
        <item name="colorOnSecondary">@color/primary_forest_green</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/primary_forest_green</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- Background -->
        <item name="android:windowBackground">@color/background_off_white</item>
    </style>
</resources>
