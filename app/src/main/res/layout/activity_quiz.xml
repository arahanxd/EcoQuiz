<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_off_white"
    android:orientation="vertical">

    <!-- Top App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_white"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <ImageView
            android:id="@+id/ivQuizBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="back"
            android:padding="6dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/primary_forest_green" />

        <TextView
            android:id="@+id/tvQuizDifficultyBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_sdg_badge"
            android:fontFamily="sans-serif-bold"
            android:paddingStart="12dp"
            android:paddingTop="4dp"
            android:paddingEnd="12dp"
            android:paddingBottom="4dp"
            android:text="EASY"
            android:textColor="@color/primary_forest_green"
            android:textSize="12sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Countdown Timer Display -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="timer"
                android:src="@drawable/ic_timer"
                app:tint="@color/error_red" />

            <TextView
                android:id="@+id/tvQuizTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="sans-serif-black"
                android:text="30s"
                android:textColor="@color/error_red"
                android:textSize="18sp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Progress Indicator -->
    <ProgressBar
        android:id="@+id/pbQuizProgress"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:max="10"
        android:progress="1"
        android:progressTint="@color/primary_forest_green" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Question Number Indicator -->
            <TextView
                android:id="@+id/tvQuestionCounter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="Question 1 of 10"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <!-- Question Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/surface_white"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/card_border"
                app:strokeWidth="1dp">

                <TextView
                    android:id="@+id/tvQuestionText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:lineSpacingExtra="4dp"
                    android:padding="20dp"
                    android:text="What is the primary greenhouse gas emitted through human activities?"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Four Options List -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical">

                <!-- Option A -->
                <RelativeLayout
                    android:id="@+id/layoutOptionA"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_option_default"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvOptionABadge"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:background="@drawable/bg_option_badge"
                        android:fontFamily="sans-serif-bold"
                        android:gravity="center"
                        android:text="A"
                        android:textColor="@color/primary_forest_green"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvOptionAText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="14dp"
                        android:layout_toEndOf="@id/tvOptionABadge"
                        android:fontFamily="sans-serif"
                        android:text="Option A Text"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />
                </RelativeLayout>

                <!-- Option B -->
                <RelativeLayout
                    android:id="@+id/layoutOptionB"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_option_default"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvOptionBBadge"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:background="@drawable/bg_option_badge"
                        android:fontFamily="sans-serif-bold"
                        android:gravity="center"
                        android:text="B"
                        android:textColor="@color/primary_forest_green"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvOptionBText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="14dp"
                        android:layout_toEndOf="@id/tvOptionBBadge"
                        android:fontFamily="sans-serif"
                        android:text="Option B Text"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />
                </RelativeLayout>

                <!-- Option C -->
                <RelativeLayout
                    android:id="@+id/layoutOptionC"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_option_default"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvOptionCBadge"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:background="@drawable/bg_option_badge"
                        android:fontFamily="sans-serif-bold"
                        android:gravity="center"
                        android:text="C"
                        android:textColor="@color/primary_forest_green"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvOptionCText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="14dp"
                        android:layout_toEndOf="@id/tvOptionCBadge"
                        android:fontFamily="sans-serif"
                        android:text="Option C Text"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />
                </RelativeLayout>

                <!-- Option D -->
                <RelativeLayout
                    android:id="@+id/layoutOptionD"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_option_default"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvOptionDBadge"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:background="@drawable/bg_option_badge"
                        android:fontFamily="sans-serif-bold"
                        android:gravity="center"
                        android:text="D"
                        android:textColor="@color/primary_forest_green"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvOptionDText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="14dp"
                        android:layout_toEndOf="@id/tvOptionDBadge"
                        android:fontFamily="sans-serif"
                        android:text="Option D Text"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />
                </RelativeLayout>

            </LinearLayout>

            <!-- Explanation Feedback Box (shown upon answer selection or timeout) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardExplanation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/secondary_mint_light"
                app:cardCornerRadius="14dp"
                app:strokeColor="@color/card_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:id="@+id/tvFeedbackTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        android:text="Correct! Well done."
                        android:textColor="@color/success_green"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvExplanationText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="sans-serif"
                        android:text="Explanation notes here."
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Next Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNextQuestion"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="24dp"
                android:backgroundTint="@color/primary_forest_green"
                android:enabled="false"
                android:fontFamily="sans-serif-bold"
                android:text="@string/btn_next"
                android:textAllCaps="false"
                android:textColor="@color/surface_white"
                android:textSize="16sp"
                app:cornerRadius="14dp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
